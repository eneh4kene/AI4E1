{
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "redirects": [
    {
      "source": "/work/acts/:path([^.]*[^./])",
      "destination": "/work/acts/:path/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/work/acts",
      "destination": "https://acts-interviewsai.vercel.app/"
    },
    {
      "source": "/work/acts/",
      "destination": "https://acts-interviewsai.vercel.app/"
    },
    {
      "source": "/work/acts/:path+/",
      "destination": "https://acts-interviewsai.vercel.app/:path+/"
    },
    {
      "source": "/work/acts/:path+",
      "destination": "https://acts-interviewsai.vercel.app/:path+"
    }
  ]
}
